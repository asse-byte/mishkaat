# =============================================================================
# Mishkaat backend — environment template
# Copy to `.env` and fill in REAL values before first boot.
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# ----- Runtime -----------------------------------------------------------
# `production` enables fail-fast on missing/default secrets.
APP_ENV=production

# ----- Crypto secrets ----------------------------------------------------
# Generate each value FRESHLY for every deployment.
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_ME_WITH_A_FRESH_64_BYTE_HEX

#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key permanently destroys encrypted PII fields. Back it up.
PII_ENCRYPTION_KEY=REPLACE_ME_WITH_A_FRESH_FERNET_KEY

# ----- Admin bootstrap ---------------------------------------------------
# Used ONLY the first time the database has no admin user.
# After first login, rotate via POST /api/auth/change-password.
INITIAL_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_12+_CHAR_PASSWORD
ADMIN_EMAIL=admin@your-domain.example

# ----- Database ----------------------------------------------------------
MONGO_URL=mongodb://mishkaat:REPLACE_ME@mongo:27017/quran_center?authSource=quran_center
DB_NAME=quran_center

# ----- HTTP / CORS -------------------------------------------------------
ALLOWED_ORIGINS=https://app.your-domain.example

# ----- Auth tuning (defaults shown) --------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ----- Seed data ---------------------------------------------------------
# Keep `false` in production. Set to `true` only for staging/demo.
SEED_DEMO_DATA=false
