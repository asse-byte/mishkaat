# =============================================================================
# Mishkaat backend — environment template
# Copy to `.env` and fill in REAL values before first boot.
# `.env` is gitignored. NEVER commit real secrets.
# =============================================================================

# ----- Runtime -----------------------------------------------------------
# `production` enables fail-fast on missing/default secrets.
APP_ENV=production

# ----- Crypto secrets ----------------------------------------------------
# Generate each value FRESHLY for every deployment.
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_ME_WITH_A_FRESH_64_BYTE_HEX

#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key permanently destroys encrypted PII fields. Back it up.
PII_ENCRYPTION_KEY=REPLACE_ME_WITH_A_FRESH_FERNET_KEY

# ----- Admin bootstrap ---------------------------------------------------
# Used ONLY the first time the database has no admin user.
# After first login, rotate via POST /api/auth/change-password.
INITIAL_ADMIN_PASSWORD=REPLACE_ME_WITH_A_STRONG_12+_CHAR_PASSWORD
ADMIN_EMAIL=admin@your-domain.example

# The super admin (sees and suspends EVERY centre) gets its own password.
# Before 2026-09-03 it silently fell back to a hardcoded "superadmin123" —
# never reuse INITIAL_ADMIN_PASSWORD here; a leak of one must not be a leak of both.
INITIAL_SUPER_ADMIN_PASSWORD=REPLACE_ME_WITH_A_DIFFERENT_STRONG_PASSWORD

# ----- Database ----------------------------------------------------------
MONGO_URL=mongodb://mishkaat:REPLACE_ME@mongo:27017/quran_center?authSource=quran_center
DB_NAME=quran_center

# ----- HTTP / CORS -------------------------------------------------------
# Comma-separated. Surrounding spaces are stripped. "*" is refused in production.
ALLOWED_ORIGINS=https://app.your-domain.example

# Set to true ONLY when the API really sits behind a reverse proxy you control
# (nginx, Traefik, a load balancer) that sets X-Forwarded-For.
# false  -> rate limiting uses the socket peer. Behind a proxy that is the proxy
#           itself, so five bad passwords from one person lock out everybody.
# true without a proxy -> a client can forge the header and evade the limiter.
TRUST_PROXY=false

# ----- Auth tuning (defaults shown) --------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Per-IP lockout is 5 attempts / 15 min (fixed). These are the per-ACCOUNT limits,
# which is what stops an attacker who rotates IP addresses.
MAX_ACCOUNT_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=15

# Password-reset codes: lifetime in minutes (5 wrong guesses invalidate the code)
RESET_CODE_TTL_MINUTES=10

# ----- Seed data ---------------------------------------------------------
# Keep `false` in production. Set to `true` only for staging/demo.
SEED_DEMO_DATA=false
